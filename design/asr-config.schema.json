{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dito cloud ASR request JSON v1",
  "description": "The request JSON of a Dito cloud speech configuration, for synchronous ASR over HTTP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "connection",
    "language_map",
    "request",
    "response"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "model"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "pattern": "^https?://",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "language_map": {
      "type": "object",
      "required": [
        "other"
      ],
      "properties": {
        "other": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "auto": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "patternProperties": {
        "^[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8})*$": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "encoding",
        "headers"
      ],
      "properties": {
        "method": {
          "enum": [
            "POST",
            "PUT"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/(?!/)[^?#]*$",
          "minLength": 1
        },
        "query": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "encoding": {
          "enum": [
            "json",
            "multipart"
          ]
        },
        "body": {
          "type": "object"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "json"
              }
            }
          },
          "then": {
            "required": [
              "body"
            ],
            "not": {
              "required": [
                "fields"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "multipart"
              }
            }
          },
          "then": {
            "required": [
              "fields"
            ],
            "not": {
              "required": [
                "body"
              ]
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_pointer"
      ],
      "properties": {
        "text_pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "language_pointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    }
  }
}
