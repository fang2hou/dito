{
  "version": 1,
  "connection": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model": ""
  },
  "language_map": {
    "ja": "ja",
    "en": "en",
    "zh": "zh",
    "auto": null,
    "other": "en"
  },
  "request": {
    "method": "POST",
    "path": "/chat/completions",
    "query": {},
    "headers": {
      "Authorization": "Bearer {{api_key}}"
    },
    "encoding": "json",
    "body": {
      "model": "{{model}}",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "input_audio",
              "input_audio": {
                "data": "{{audio.data_uri}}"
              }
            }
          ]
        }
      ],
      "stream": false,
      "asr_options": {
        "language": "{{language}}",
        "enable_itn": false
      }
    }
  },
  "response": {
    "text_pointer": "/choices/0/message/content"
  }
}
